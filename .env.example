# Copy to .env.local for local dev only. Never commit .env.local — gitignored.
# In production the frontend is served by the same backend (or built with the
# backend URL), so NO frontend env vars are required.

# Optional in local dev. If empty, the Vite dev server proxies /api to
# http://localhost:8000 automatically (see vite.config.ts), so this is only
# needed if you run the frontend without the proxy.
VITE_API_BASE_URL=http://localhost:8000

# Optional fallback only. The backend exposes its (public) Razorpay Key ID at
# GET /api/config, which the Donate page reads at runtime — so you normally
# do NOT need to set these here. Kept only for local setups without a backend.
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx