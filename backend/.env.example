ENVIRONMENT=development
# Production (PostgreSQL). Render: create a Postgres database and paste its internal URL here.
DATABASE_URL=sqlite:///./temple.db
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Generate:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE_MINUTES=720

# Admin login used by the (future) dashboard. Hash from:
#   python scripts/hash_password.py "YourStrongPassword123!"
ADMIN_EMAIL=admin@jagannathmandirrohini.com
ADMIN_PASSWORD_HASH=replace-with-bcrypt-hash

# Razorpay dashboard -> Settings -> API Keys. Use rzp_test_* while testing,
# rzp_live_* only when ready to accept real money.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace-with-key-secret
# Razorpay dashboard -> Settings -> Webhooks. Different from the key secret!
RAZORPAY_WEBHOOK_SECRET=replace-with-webhook-secret

# Comma-separated exact origins (no trailing slash). Add your live domain in prod.
ALLOWED_ORIGINS=http://localhost:5173,https://jagannathmandirrohini.com

# YouTube Live Darshan (optional — homepage just hides the live banner if empty)
YOUTUBE_CHANNEL_ID=
YOUTUBE_API_KEY=

# SMTP Email (Gmail App Password / SendGrid / Resend). Empty => emails skipped,
# site still works. Gmail tip: dashboard -> app password, not your login password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com

RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_FORMS=5/minute
RATE_LIMIT_DONATIONS=10/minute

# For single-container deploy (Docker), point at the built frontend so this
# process also serves the website. Leave empty when Vite serves the frontend.
FRONTEND_DIST=../frontend/dist

# Membership form uploads (photos / ID proofs). Validated by magic bytes and
# stored as binary rows in the DATABASE (Supabase/Postgres in prod) — no local
# disk used, so uploads survive container restarts.
MAX_UPLOAD_BYTES=5242880

# Optional: pre-created Razorpay Plan ID for the ₹200/month recurring Dainik
# Sewa subscription. If empty, a monthly plan is created automatically once.
DAINIK_SEWA_PLAN_ID=